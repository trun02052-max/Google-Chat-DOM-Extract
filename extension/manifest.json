{
  "manifest_version": 3,
  "name": "My Chat AI Bridge",
  "version": "0.2.0",
  "description": "Bridge Google Chat to my local AI server.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}